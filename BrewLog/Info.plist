<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys generated from project.yml (GENERATE_INFOPLIST_FILE). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Keep the brew running while the app is in the background: cues (audio) and live weight (scale). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
	</array>
	<!-- Plain ws:// to the espresso machine (GaggiMate) in the local network. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Where online recipe updates are downloaded from. Set by CI; empty = off. -->
	<key>BrewLogRecipeFeedURL</key>
	<string>$(RECIPE_FEED_URL)</string>
	<!-- App Group shared with the widgets. SideStore/AltStore rewrite ALTAppGroups to the group they registered. -->
	<key>ALTAppGroups</key>
	<array>
		<string>$(BREWLOG_APP_GROUP)</string>
	</array>
	<key>BrewLogAppGroup</key>
	<string>$(BREWLOG_APP_GROUP)</string>
	<!-- brewlog:// links from the widgets. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>brewlog</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
