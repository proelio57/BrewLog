# Extra security headers for Cloudflare Pages and Netlify (other hosts ignore this file).
# The Content Security Policy itself is a <meta> tag in index.html, so it works everywhere.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Bundles have hashed file names and never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
