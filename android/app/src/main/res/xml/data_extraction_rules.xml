<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy: nothing is uploaded to cloud backups. Phone-to-phone transfer (cable/local) keeps your brew history. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
